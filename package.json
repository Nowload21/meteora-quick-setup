{
  "name": "meteora-quick-setup",
  "version": "0.1.6",
  "private": true,
  "description": "Chrome extension for preparing and creating Meteora DLMM SOL-side positions from presets.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run check && npm run test && npm run build",
    "watch": "node build.mjs --watch"
  },
  "dependencies": {
    "@meteora-ag/dlmm": "1.9.14",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.2"
  },
  "devDependencies": {
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "@esbuild-plugins/node-modules-polyfill": "^0.2.2",
    "@types/bn.js": "^5.2.0",
    "@types/chrome": "^0.1.4",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
