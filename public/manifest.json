{
  "manifest_version": 3,
  "name": "Meteora Quick Setup",
  "version": "0.1.9",
  "description": "Create Meteora DLMM SOL-side positions from configurable presets.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://app.meteora.ag/*",
    "https://www.meteora.ag/*",
    "https://dlmm.datapi.meteora.ag/*",
    "https://lite-api.jup.ag/*",
    "https://api.mainnet-beta.solana.com/*",
    "https://*.helius-rpc.com/*",
    "https://*.solana.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Meteora Quick Setup"
  },
  "content_scripts": [
    {
      "matches": ["https://app.meteora.ag/*", "https://www.meteora.ag/*"],
      "js": ["content-bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["https://app.meteora.ag/*", "https://www.meteora.ag/*"],
      "js": ["main-world.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
